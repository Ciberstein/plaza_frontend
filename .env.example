# The API this app talks to.
VITE_API_URL=http://localhost:4000

# Google Maps, for the property section: the map on a listing's page and the
# drag-the-pin picker in the editor.
#
# Optional. Without it the property pages still say where the place is in
# words and the editor still takes an address — there is simply no map. A
# missing key is a missing map, never a broken screen.
#
# This key is sent by the browser, so it is public by design. Restrict it by
# HTTP referrer to your own domains in the Google Cloud console, or anybody
# can lift it out of the bundle and spend it against your account. Enable
# "Maps JavaScript API" and "Geocoding API"; both sit in the Essentials tier,
# which carries 10,000 free calls per month each.
VITE_GOOGLE_MAPS_KEY=
